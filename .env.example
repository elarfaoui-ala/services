# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=auth_module
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme-use-a-strong-password

# Auth Module
JWT_SECRET=changeme-use-a-long-random-string

# AI Module
ANTHROPIC_API_KEY=sk-ant-...

# Notification Module (optional)
API_KEY=generate-a-strong-random-string-for-production

# Frontend URLs
FRONTEND_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Gateway (production)
# DOMAIN=api.example.com
# EMAIL=admin@example.com
GATEWAY_SSL_PORT=443

# Logging (debug, info, warn, error)
LOG_LEVEL=info

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3003
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme
ALERTMANAGER_PORT=9094
